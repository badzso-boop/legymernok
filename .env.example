# Másold le ezt a fájlt .env névvel és töltsd ki az értékeket:
# cp .env.example .env

# Gitea admin jelszó és API token
# A tokent a Gitea admin felületen kell legenerálni: http://localhost:3001/user/settings/applications
# (vagy nem-interaktívan a CLI-vel, lásd README "Nem-interaktív / automatizált setup")
GITEA_ADMIN_PASSWORD=change_me
GITEA_ADMIN_TOKEN=change_me

# Gitea belső titkai — a webes telepítő varázsló ezeket automatikusan generálja,
# de ha az INSTALL_LOCK=true-val kihagyod a varázslót (lásd README), akkor ezeket
# előre le kell generálni:
#   docker exec -u git legymernok-gitea gitea generate secret SECRET_KEY
#   docker exec -u git legymernok-gitea gitea generate secret INTERNAL_TOKEN
#   docker exec -u git legymernok-gitea gitea generate secret JWT_SECRET
GITEA_SECRET_KEY=change_me
GITEA_INTERNAL_TOKEN=change_me
GITEA_JWT_SECRET=change_me

# JWT aláíró kulcs - legalább 32 karakter véletlenszerű string legyen
# Generálás: openssl rand -hex 32
JWT_SECRET=change_me_min_32_chars_random_string

# Gitea Actions callback secret - szintén véletlen string
# Generálás: openssl rand -hex 32
MISSION_VERIFICATION_SECRET=change_me_min_32_chars_random_string

# Gitea Actions runner regisztrációs token (Gitea admin felületen: /admin/runners)
REGISTRATION_TOKEN=change_me
